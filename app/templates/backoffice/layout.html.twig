{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ encore_entry_link_tags('backoffice') }}
{% endblock %}

{% block javascripts %}
    {{ encore_entry_script_tags('backoffice') }}
{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gray-100">
        <div id="sidebar-overlay" class="fixed inset-0 z-30 hidden bg-black/50 md:hidden"></div>

        {{ include('backoffice/partials/_sidebar.html.twig') }}
        <div class="md:pl-64">
            {{ include('backoffice/partials/_topbar.html.twig') }}
            <main class="p-4 md:p-6">
                {% block content %}{% endblock %}
            </main>
        </div>
    </div>
{% endblock %}
