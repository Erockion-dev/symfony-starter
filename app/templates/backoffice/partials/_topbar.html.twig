<header class="sticky top-0 z-20 flex h-16 items-center border-b bg-white px-4">

    <button id="sidebar-toggle" type="button" aria-label="Ouvrir le menu"
            class="rounded-md p-2 text-gray-600 hover:bg-gray-100 md:hidden">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
    </button>

    <nav class="ml-4 hidden items-center gap-1 md:flex">
        <a href="{{ path('app_dashboard_admin_users_index') }}"
        class="rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-100">
            LinkOne
        </a>
    </nav>
    <nav class="ml-4 hidden items-center gap-1 md:flex">
        <a href="{{ path('app_dashboard_admin_users_index') }}"
            class="rounded-md px-3 py-2 text-sm hover:bg-gray-100 {{ route starts with 'app_dashboard_admin_user' ? 'bg-gray-100 font-medium text-gray-900' : 'text-gray-700' }}">
            LinkTwo
        </a>
    </nav>

    <details class="relative" data-dropdown>
        <summary class="flex cursor-pointer list-none items-center gap-1 rounded-md px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 [&::-webkit-details-marker]:hidden">
            dropdown
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
            </svg>
        </summary>
        <div class="absolute left-0 z-50 mt-1 w-48 rounded-md border bg-white py-1 shadow-lg">
            <a href="#" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">UnderLinkOne</a>
            <a href="{{ path('app_home') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Front</a>
        </div>
    </details>

    <div class="ml-auto flex items-center gap-4 text-sm text-gray-600">
        {% if app.user %}
            <span class="hidden sm:inline">{{ app.user.email }}</span>
            <a href="{{ path('app_logout') }}" class="btn-secondary">Sign out</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-primary">Sign in</a>
        {% endif %}
    </div>
</header>

