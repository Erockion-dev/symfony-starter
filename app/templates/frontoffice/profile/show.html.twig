{% extends 'frontoffice/layout.html.twig' %}

{% block title %}My profile{% endblock %}

{% block body %}
    {{ parent() }}

    <main class="mx-auto max-w-2xl p-4 md:p-6">
        <h1 class="mb-4">My profile</h1>

        <div class="overflow-x-auto rounded-lg border bg-white">
            <table class="min-w-full divide-y divide-gray-100 text-sm">
                <tbody class="divide-y divide-gray-100">
                    <tr>
                        <th class="w-1/3 bg-gray-50 px-4 py-3 text-left font-medium text-gray-500">First name</th>
                        <td class="px-4 py-3 text-gray-900">{{ app.user.firstName }}</td>
                    </tr>
                    <tr>
                        <th class="bg-gray-50 px-4 py-3 text-left font-medium text-gray-500">Last name</th>
                        <td class="px-4 py-3 text-gray-900">{{ app.user.lastName }}</td>
                    </tr>
                    <tr>
                        <th class="bg-gray-50 px-4 py-3 text-left font-medium text-gray-500">Email</th>
                        <td class="px-4 py-3 text-gray-900">{{ app.user.email }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </main>
{% endblock %}
